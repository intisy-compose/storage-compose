# Local config (copy config.env from config.env.example, or run init-config)
config.env

# The CLI's requests to the host agent and its answers
attach-request.json*
attach-state.json*

# Written by the host agent: its log, port assignments, heartbeat and the Syncthing it runs
host-agent/

# The log of the logon task the host agent replaced
attach.log*

# Mounted in place of the setup repo and its git home while SETUP_REPO_DIR and SETUP_GIT_HOME are unset
setup-repo-unset/

# Built from images/dashboard/ui by npm run build:ui (also in the image build)
images/dashboard/public/index.html

# Mounted in place of NODE_VOLUMES while it is unset
node-volumes-unset/
