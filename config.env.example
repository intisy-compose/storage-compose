# Copy to config.env (gitignored), or run `init-config`, which copies this file and fills in
# STORAGE_NODE with this computer's name.

# Tailscale. The array joins your tailnet as TS_HOSTNAME and is served at
# https://<TS_HOSTNAME>.<tailnet>.ts.net. TS_AUTHKEY is only needed for the first join, since the node
# key is kept on the array; create one at https://login.tailscale.com/admin/settings/keys. HTTPS
# certificates must be enabled for the tailnet.
TS_AUTHKEY=
TS_HOSTNAME=storage

# Written by `up` once the node has joined; leave it empty.
STORAGE_HOST=

# The name this host writes into the array's lock. `up` refuses while another host held the lock in
# the last LOCK_TIMEOUT_SECONDS.
STORAGE_NODE=
LOCK_TIMEOUT_SECONDS=600

# Drives are found by their ext4 label, <ARRAY_PREFIX>-data1, <ARRAY_PREFIX>-parity1 and so on
# (at most 16 characters). <ARRAY_PREFIX>-data1 holds the stack state.
ARRAY_PREFIX=storage

# The pool writes new files to the data drive with the most free space and skips any drive with less
# than this left (mergerfs minfreespace).
POOL_MIN_FREE_SPACE=4G

# Where the drives are mounted: a path in Docker Desktop's VM on Windows, on the host on Linux.
STORAGE_ROOT=/mnt/storage

# Windows only: the enclosures' USB bridges as VID:PID, separated by commas. `up` attaches every
# device with one of these IDs to Docker Desktop's VM and `down` gives them back. List them with
# `usbipd list`.
USB_HARDWARE_IDS=
