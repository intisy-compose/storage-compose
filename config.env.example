# Copy to config.env (gitignored), or run `init-config`, which copies this file and fills in
# STORAGE_NODE with this computer's name and NTFY_TOPIC with a new random topic.

# Tailscale. The array joins your tailnet as TS_HOSTNAME and is served at
# https://<TS_HOSTNAME>.<tailnet>.ts.net. TS_AUTHKEY is only needed for the first join, since the node
# key is kept on the array; create one at https://login.tailscale.com/admin/settings/keys. HTTPS
# certificates must be enabled for the tailnet.
TS_AUTHKEY=
TS_HOSTNAME=storage

# Written by `up` once the node has joined; leave it empty.
STORAGE_HOST=

# The name this host writes into the array's lock. `up` refuses while another host held the lock in
# the last LOCK_TIMEOUT_SECONDS.
STORAGE_NODE=
LOCK_TIMEOUT_SECONDS=600

# Every array is found by its drives' ext4 labels, <id>-data1, <id>-parity1 and so on, where <id> is
# the array's 4 hex digit id; any number of arrays run side by side. ARRAY_PREFIX names the array
# whose data1 holds the stack state (secrets, tailnet identity, Syncthing, Kopia). An array still on
# the old labels (storage-data1, ...) runs under ARRAY_PREFIX=storage until `migrate-labels` moves it
# to its id and writes the id here.
ARRAY_PREFIX=storage

# Linux hosts, opt-in: the folder where the host mounts removable volumes (/media/<user>,
# /run/media/<user>) or a data volume such as /data. A volume root with .storage/node.toml there is a
# drive node, and one with .storage/nodes.toml lists folder nodes; only those two files are read.
# Unset, the stack looks only in its own node-volumes-unset folder and creates nothing on the host.
# On Windows the host agent finds drive and folder nodes instead.
NODE_VOLUMES=

# Device and mount events start a discovery at once; this slow poll only catches a missed one.
DISCOVERY_POLL_SECONDS=300

# Other hosts' storage dashboards, read over the tailnet for their nodes, separated by commas:
# https://storage-p53.<tailnet>.ts.net. A host that cannot be reached shows what Syncthing knows.
STORAGE_PEERS=

# The dashboard answers only requests addressed to localhost, 127.0.0.1, [::1] or STORAGE_HOST, so a
# page on another site that points its own name at 127.0.0.1 gets 421. Further names it is reached
# by (a reverse proxy of your own, a LAN name), comma separated, the port left out: nas.lan.
DASHBOARD_EXTRA_HOSTS=

# A device on the tailnet joins through POST /api/join when it is tagged tag:storage, owned by the
# user who owns this host's tailnet node, or owned by a login listed here (comma separated; needed
# when the node was created with a tagged auth key and so has no user).
JOIN_ALLOWED_USERS=

# The setup repo, by default the stack's own data repo (./data). An admitted device is written into
# SETUP_LAYOUT there, committed and pushed (shown as not pushed yet while that fails); while the repo
# has no SETUP_LAYOUT, admissions are recorded on this host only. SETUP_GIT_HOME is a folder with the
# .gitconfig (the commit identity) and .ssh keys that git uses inside the container.
SETUP_REPO_DIR=
SETUP_LAYOUT=drive-sync.toml
SETUP_GIT_HOME=

TIMEZONE=Europe/Berlin

# Notifications go to ntfy: subscribe to NTFY_TOPIC on NTFY_URL in the ntfy app. The topic is the only
# secret, so `init-config` generates an unguessable one; empty turns notifications off (they are
# still logged). Point NTFY_URL at a self-hosted ntfy to keep them off ntfy.sh.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

# A drive that drops off the USB bus and is back within DROP_GRACE_SECONDS is a drop: it is checked
# (e2fsck -p), mounted again and the array carries on. One that stays away longer counts as missing.
DROP_GRACE_SECONDS=120

# How often the mounter reads every drive's SMART counts (a sleeping drive is left asleep). A drive
# whose reallocated, pending or uncorrectable counts rise above their values at its first check is
# failing; `accept-smart <role>` takes its current values as the new baseline.
SMART_INTERVAL_HOURS=6

# The pool writes a new file to the drive that already holds its folder (a new top-level folder to the
# drive with the most free space) and skips any drive with less than this left (mergerfs minfreespace).
POOL_MIN_FREE_SPACE=4G

# SnapRAID runs a sync once the last one is SYNC_INTERVAL_HOURS old and a scrub once the last is
# SCRUB_INTERVAL_DAYS old, checked every 10 minutes and first
# START_DELAY_SECONDS after the start. A sync is refused while more than SYNC_MAX_DELETED files were
# deleted since the last one; `sync --anyway` accepts them. Both wait while a drive is away.
SYNC_INTERVAL_HOURS=24
SCRUB_INTERVAL_DAYS=7
SYNC_MAX_DELETED=500
START_DELAY_SECONDS=300

# What one scrub checks: SCRUB_PERCENT of the array, blocks not checked for SCRUB_OLDER_THAN_DAYS.
SCRUB_PERCENT=8
SCRUB_OLDER_THAN_DAYS=10

# The dashboard offers only unused drives on these transports as replacements, so the host's own
# disks are never offered for erasing. `wsl` is a blank disk passed through on Windows with
# `attach <disk number>`; `loop` adds loop devices, for tests with image files.
CANDIDATE_TRANSPORTS=usb,wsl

# The dashboard's Attention page lists a node or Syncthing device offline for longer than
# ATTENTION_OFFLINE_HOURS, and a node or drive more than ATTENTION_FULL_PERCENT full.
ATTENTION_OFFLINE_HOURS=24
ATTENTION_FULL_PERCENT=90

# The dashboard's Activity page keeps, in memory only, the newest ACTIVITY_BUFFER entries of each
# Syncthing instance (and as many of its scans and file changes), each array's parity jobs and the
# dashboard's own writes.
ACTIVITY_BUFFER=2000

# The dashboard's Folders explorer places each folder's outstanding and failed items in its tree
# when there are at most EXPLORER_NEED_LIMIT of them; above it, every directory of that folder shows
# the folder's count instead.
EXPLORER_NEED_LIMIT=20000

# The dashboard searches each folder for Syncthing's conflict copies one directory at a time,
# pausing CONFLICT_SWEEP_PAUSE_MS between two reads so Syncthing keeps answering everything else
# (0 for no pause). Every CONFLICT_RECHECK_HOURS it checks each folder's index against Syncthing
# and searches a folder again where updates were missed.
CONFLICT_SWEEP_PAUSE_MS=10
CONFLICT_RECHECK_HOURS=24

# Syncthing lists a folder's file versions whole, without pages. The dashboard reads at most
# VERSIONS_LIST_MAX_MB of that list for its versions browser and refuses a larger one.
VERSIONS_LIST_MAX_MB=16

# The dashboard remembers every Syncthing device it has seen and how it was last connected (this
# device, local network, Tailscale, internet, relay) in /status/seen, rewriting that file at most
# every SEEN_WRITE_INTERVAL_S seconds.
SEEN_WRITE_INTERVAL_S=60

# Where the drives are mounted: a path in Docker Desktop's VM on Windows, on the host on Linux.
STORAGE_ROOT=/mnt/storage

# Windows only: how the drives reach Docker Desktop's VM.
# wsl     passes every USB disk whose partitions are all of the GPT type "Linux filesystem" through
#         with `wsl --mount --bare`, at the disk's own speed; the host agent does it, a Windows
#         service that `up` installs when run in an admin shell.
# usbipd  attaches the enclosures over usbipd, much slower (about 25 MB/s for the whole array).
ATTACH=wsl

# ATTACH=usbipd only: the enclosures' USB bridges as VID:PID, separated by commas. `up` attaches
# every device with one of these IDs to Docker Desktop's VM and `down` gives them back. List them
# with `usbipd list`.
USB_HARDWARE_IDS=

# Public access, the same switch in every stack on the shared gateway: true opens the tailnet sites
# to the internet through Tailscale Funnel, with no login of their own (needs the "funnel" node
# attribute in the tailnet policy). See CONTENT.md of intisy-compose/workflows.
PUBLIC_ACCESS=false
