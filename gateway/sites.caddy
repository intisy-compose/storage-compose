# Syncthing's GUI listens on 8385 in this same namespace and rejects any Host but its own; its sync
# protocol on 22000 and Samba on 445 bypass Caddy.
(syncthing) {
	reverse_proxy 127.0.0.1:8385 {
		header_up Host 127.0.0.1:8385
	}
}

# tailscale names each caller in a PROXY protocol header (TAILNET_PROXY_PROTOCOL), and the join API
# is handed it in one of its own, the only way the dashboard learns which tailnet device joins.
{$TAILNET_HOST}:443 {
	import tailnet
	encode gzip
	handle /api/join {
		reverse_proxy dashboard:8447 {
			transport http {
				proxy_protocol v2
			}
		}
	}
	handle {
		reverse_proxy dashboard:8080
	}
}

# Kopia's clients speak gRPC, which needs HTTP/2 through to the server, and Kopia offers HTTP/2
# only over TLS: its self-signed certificate is trusted on the stack's private network only.
{$TAILNET_HOST}:51515 {
	import tailnet
	reverse_proxy https://kopia:51515 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

http://:8442 {
	encode gzip
	reverse_proxy dashboard:8080
}

# This host only: the tailnet reaches Syncthing's sync protocol, never its GUI.
http://:8443 {
	import syncthing
}
