# Runs inside the tailscale container's network namespace. Certificates for the ts.net name come
# from tailscaled over its socket, so every device on the tailnet gets real, auto-renewed HTTPS.
{
	admin off
	auto_https disable_redirects
}

{$STORAGE_HOST}:443 {
	encode gzip
	reverse_proxy dashboard:8080
}

# Syncthing's GUI listens on 8385 in this same namespace and rejects any Host but its own; its sync
# protocol on 22000 bypasses Caddy.
{$STORAGE_HOST}:8384 {
	reverse_proxy 127.0.0.1:8385 {
		header_up Host 127.0.0.1:8385
	}
}

# Kopia's clients speak gRPC, which needs HTTP/2 through to the server, and Kopia offers HTTP/2
# only over TLS: its self-signed certificate is trusted on the stack's private network only.
{$STORAGE_HOST}:51515 {
	reverse_proxy https://kopia:51515 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}
