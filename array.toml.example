# The description of an array still on the old labels (storage-data1, ...). It lives on the array, in
# storage-data1/.storage/array.toml (mirrored to data2 with the rest of the stack state), not in this
# repo, and names each role's asset note in notifications. `migrate-labels` moves the assets and
# serials into .storage/node.toml on every member and keeps this file as array.toml.before-migration.

[parity1]
asset = "SAM-0001"
item = 1
serial = "ABC123"

[data1]
asset = "SAM-0002"
item = 2
serial = "DEF456"
