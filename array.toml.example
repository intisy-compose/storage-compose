# The array's description. It lives on the array, in <ARRAY_PREFIX>-data1/.storage/array.toml (mirrored
# to data2 with the rest of the stack state), not in this repo. The dashboard links each role to its
# inventory item and warns when the drive it finds has another serial, as after a rebuild onto a
# replacement: then give the role its new asset here. Removing a drive from the array drops its section.

# The inventory's page for a stock item; the role's `item` is appended.
inventory_item_url = "https://inventree.example.ts.net/web/stock/item/"

[parity1]
asset = "SAM-0001"
item = 1
serial = "ABC123"

[data1]
asset = "SAM-0002"
item = 2
serial = "DEF456"
