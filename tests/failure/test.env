# The fault-injection test's settings; the drive prefix keeps the stack off any real array drive.
STORAGE_NODE=c24test
ARRAY_PREFIX=c24t
STORAGE_ROOT=/mnt/c24test
LAB_IMAGES=/var/lib/c24test
NTFY_URL=http://lab:8080
NTFY_TOPIC=c24test
DROP_GRACE_SECONDS=120
SMART_INTERVAL_HOURS=0
START_DELAY_SECONDS=20
SYNC_INTERVAL_HOURS=100000
SCRUB_INTERVAL_DAYS=100000
SCRUB_PERCENT=100
SCRUB_OLDER_THAN_DAYS=0
CANDIDATE_TRANSPORTS=loop
POOL_MIN_FREE_SPACE=50M
TIMEZONE=UTC
PEER_API_KEY=c24t-peer-key
