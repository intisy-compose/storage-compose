# The nodes test's settings; the prefixes and paths keep the stack off any real drive.
STORAGE_NODE=stntest
ARRAY_PREFIX=stnc
STORAGE_ROOT=/mnt/stntest
NODE_VOLUMES=/mnt/stntest-volumes
LAB_IMAGES=/var/lib/stntest
STORAGE_HOST=stntest.invalid
NTFY_TOPIC=
DROP_GRACE_SECONDS=30
SMART_INTERVAL_HOURS=0
START_DELAY_SECONDS=100000
SYNC_INTERVAL_HOURS=100000
SCRUB_INTERVAL_DAYS=100000
CANDIDATE_TRANSPORTS=loop
POOL_MIN_FREE_SPACE=10M
DISCOVERY_POLL_SECONDS=300
TIMEZONE=UTC
